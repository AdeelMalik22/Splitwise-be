# Local development defaults. Never commit a real .env file.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=splitwise_drf
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CSRF_TRUSTED_ORIGINS=

JWT_ACCESS_MINUTES=60
DRF_ANON_RATE=20/minute
DRF_USER_RATE=120/minute
DRF_PAGE_SIZE=50

# Use an SMTP backend in deployed environments.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost
