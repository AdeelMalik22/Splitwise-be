# Copy to .env on the server (never commit .env).
# Your public hostname, e.g. splitease.duckdns.org (must point at the server's Elastic IP).
DOMAIN=splitease.example.com

# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(50))"
# Keep it stable: changing it signs everyone out.
DJANGO_SECRET_KEY=

# Use URL-safe characters only (it goes into a connection URL): openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=splitwise
POSTGRES_USER=splitwise

# --- Email (verification, password reset, invites) ---
# Without these, emails are only printed to the server log and nobody receives them.
# Gmail: enable 2-step verification, then create an "App password" (Google Account -> Security).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SplitEase <your.address@gmail.com>
# The address people's phones use to reach the server; used in the links inside emails.
PUBLIC_BASE_URL=http://15.134.231.253:8000

# How long a login stays valid without typing the password (also bounds fingerprint login). Default 30.
JWT_REFRESH_DAYS=30
