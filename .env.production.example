# Copy to .env on the server (never commit .env).
# Your public hostname, e.g. splitease.duckdns.org (must point at the server's Elastic IP).
DOMAIN=splitease.example.com

# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(50))"
# Keep it stable: changing it signs everyone out.
DJANGO_SECRET_KEY=

# Use URL-safe characters only (it goes into a connection URL): openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=splitwise
POSTGRES_USER=splitwise
